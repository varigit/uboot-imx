/* SPDX-License-Identifier: GPL-2.0+ */
/* Android environment adapted from lf_v2024.04_android-15.0.0_1.2.0_var01. */
splashpos=m,m
splashimage=0x50000000
fdt_high=0xffffffffffffffff
initrd_high=0xffffffffffffffff
emmc_dev=2
sd_dev=1
boot_devices_mmcblk1=soc@0/30800000.bus/30b50000.mmc
boot_devices_mmcblk2=soc@0/30800000.bus/30b60000.mmc
/*
 * As on NXP boards, bootargs is left unset so that boota uses the
 * vendor_boot command line (BOARD_KERNEL_CMDLINE) and bootconfig
 * (BOARD_BOOTCONFIG). Only the arguments that depend on the detected
 * board and RAM size are added here, through bootargs_ram_capacity.
 * The board code sets console to ttymxc1 on VAR-SOM and VAR-SMARC.
 */
console=ttymxc0,115200
consoleargs=
    if test "${console}" = "ttymxc1,115200"; then
        setenv consoledev ttymxc1;
    else
        setenv consoledev ttymxc0;
    fi;
    setenv bootargs_ram_capacity console=${console} androidboot.console=${consoledev};
cmaargs=
    run consoleargs;
    if test ${sdram_size} -le 2048; then
        setenv cmavar 550M@0x400M-0xb80M;
    else
        setenv cmavar 1184M@0x400M-0x1000M;
    fi;
    setenv bootargs_ram_capacity ${bootargs_ram_capacity} cma=${cmavar} ${galcore_var};
bootcmd=run cmaargs; boota ${fastboot_dev}
bootcmd_android_recovery=run cmaargs; boota recovery
