/* Board-dependent Android arguments; common arguments come from vendor_boot. */
splashpos=m,m
fdt_high=0xffffffffffffffff
initrd_high=0xffffffffffffffff
console=ttymxc0,115200
emmc_dev=2
sd_dev=1
boot_devices_mmcblk1=soc@0/30800000.bus/30b50000.mmc
boot_devices_mmcblk2=soc@0/30800000.bus/30b60000.mmc
kernelbootargs=
    if test "${board_name}" = "VAR-SOM-MX8M-MINI"; then
        setenv androidconsole ttymxc3;
    else
        setenv androidconsole ttymxc0;
    fi;
    setenv bootargs_ram_capacity console=${console} androidboot.console=${androidconsole}
        androidboot.hardware_variant=${board_name} androidboot.som_ver=${som_rev};
bootcmd=run kernelbootargs; bootmcu; boota ${fastboot_dev}
bootcmd_android_recovery=run kernelbootargs; boota recovery
