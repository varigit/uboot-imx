#include <env/nxp/imx_env.env>

#ifdef CONFIG_ANDROID_SUPPORT
boot_devices_mmcblk0=soc@0/42800000.bus/42850000.mmc
boot_devices_mmcblk1=soc@0/42800000.bus/42860000.mmc
emmc_dev=0
fdt_high=0xffffffffffffffff
initrd_high=0xffffffffffffffff
sd_dev=1
splashimage=0x90000000
splashpos=m,m
#else
emmc_dev=0
initrd_addr=0x83800000
initrd_high=0xffffffffffffffff
sd_dev=1
#endif

#ifdef CONFIG_AHAB_BOOT
sec_boot=yes
#else
sec_boot=no
#endif

bootdir=/boot
bootenv=uEnv.txt
boot_fit=no
bootm_size=0x10000000
boot_targets=usb0 mmc0 mmc1 dhcp
cntr_addr=0x98000000
cntr_file=os_cntr_signed.bin
console=ttyLP0,115200 earlycon
fdt_addr=0x83000000
fdt_addr_r=0x83000000
fdt_file=undefined
fdt_high=0xffffffffffffffff
image=Image.gz
img_addr=0x82000000
kernel_addr_r=CONFIG_SYS_LOAD_ADDR
m33_addr=0x201e0000
m33_addr_auxview=0x1ffe0000
m33_bin=cm_hello_world.bin.release
mmcautodetect=yes
mmcdev=CONFIG_ENV_MMC_DEVICE_INDEX
mmcpart=1
mmcroot=/dev/mmcblk1p2 rootwait rw
nfsroot=/srv/nfs/CONFIG_SYS_BOARD/rootfs
scriptaddr=0x83500000
script=boot.scr
splashimage=0x90000000
use_m33=no
loadm33bin=
	load mmc "${mmcdev}:${mmcpart}" "${loadaddr}" "${bootdir}/${m33_bin}";
	cp.b "${loadaddr}" "${m33_addr}" "${filesize}";
runm33bin=
	echo Booting M33 from TCM;
	stopaux;
	bootaux "${m33_addr_auxview}";
optargs=setenv bootargs "${bootargs}" "${kernelargs}";
mmcargs=
	setenv bootargs "${jh_clk}" console="${console}"
	"${cma_size}" cma_name=linux,cma
	"root=/dev/mmcblk${mmcblk}p${mmcpart}" rootwait rw
loadbootscript=load mmc "${mmcdev}:${mmcpart}" "${loadaddr}" "${bootdir}/${script}"
bootscript=echo Running bootscript from mmc ...; source
loadbootenv=load mmc "${mmcdev}:${mmcpart}" "${loadaddr}" "${bootdir}/${bootenv}"
importbootenv=
	echo Importing environment from mmc ...;
	env import -t -r "${loadaddr}" "${filesize}"
loadimage=
	load mmc "${mmcdev}:${mmcpart}" "${img_addr}" "${bootdir}/${image}";
	unzip "${img_addr}" "${loadaddr}"
findfdt=
	if test "${fdt_file}" = undefined; then
		if test "${som_has_wbe}" = 1; then
			setenv WBE_SUFFIX -wbe;
		else
			setenv WBE_SUFFIX ;
		fi;
		if test "${board_name}" = VAR-SOM-MX93; then
			setenv module_name imx93-var-som;
			if test "${carrier_name}" = undefined; then
				setenv carrier_name symphony;
			fi;
			setenv fdt_file "${module_name}${WBE_SUFFIX}-${carrier_name}.dtb";
			if test "${som_rev}" -lt 2; then
				echo Warning: Only SoM revisions >= 2.0 are supported;
			fi;
		else
			setenv module_name imx93-var-dart;
			if test "${carrier_name}" = undefined; then
				setenv carrier_name sonata;
			fi;
			if test "${carrier_name}" = dt8mcustomboard; then
				setenv fdt_file "${module_name}-${carrier_name}.dtb";
			else
				setenv fdt_file "${module_name}${WBE_SUFFIX}-${carrier_name}.dtb";
			fi;
		fi;
	fi;
loadfdt=
	run findfdt; echo "fdt_file=${fdt_file}";
	load mmc "${mmcdev}:${mmcpart}" "${fdt_addr_r}" "${bootdir}/${fdt_file}"
loadcntr=load mmc "${mmcdev}:${mmcpart}" "${cntr_addr}" "${bootdir}/${cntr_file}"
auth_os=booti "${cntr_addr}"
boot_os=booti "${loadaddr}" - "${fdt_addr_r}"
mmcboot=
	echo Booting from mmc ...;
	run ramsize_check; run mmcargs; run optargs;
	if test "${sec_boot}" = yes; then
		run auth_os;
	else
		if test "${boot_fit}" = yes || test "${boot_fit}" = try; then
			bootm "${loadaddr}";
		else
			if run loadfdt; then
				run boot_os;
			else
				echo WARN: Cannot load the DT;
			fi;
		fi;
	fi;
netargs=
	setenv bootargs "${jh_clk}" console="${console}"
	"${cma_size}" cma_name=linux,cma
	root=/dev/nfs
	ip=dhcp nfsroot="${serverip}:${nfsroot},v3,tcp"
netboot=
	echo Booting from net ...;
	run ramsize_check;
	run netargs;
	run optargs;
	if test "${ip_dyn}" = yes; then
		setenv get_cmd dhcp;
	else
		setenv get_cmd tftp;
	fi;
	if test "${sec_boot}" = yes; then
		"${get_cmd}" "${cntr_addr}" "${cntr_file}";
		run auth_os;
	else
		"${get_cmd}" "${img_addr}" "${image}"; unzip "${img_addr}" "${loadaddr}";
		if test "${boot_fit}" = yes || test "${boot_fit}" = try; then
			bootm "${loadaddr}";
		else
			run findfdt;
			if "${get_cmd}" "${fdt_addr_r}" "${fdt_file}"; then
				run boot_os;
			else
				echo WARN: Cannot load the DT;
			fi;
		fi;
	fi;
ramsize_check=
	if test "${sdram_size}" -le 512; then
		setenv cma_size cma=32M;
	else
		setenv cma_size cma=128M;
	fi;
bsp_bootcmd=
	echo Running BSP bootcmd ...;
	if env exists mender_setup; then
		run mender_setup;
	fi;
	mmc dev "${mmcdev}";
	if mmc rescan; then
		if test "${use_m33}" = yes && run loadm33bin; then
			run runm33bin;
		fi;
		if run loadbootscript; then
			run bootscript;
		else
			if run loadbootenv; then
				echo Loaded environment from "${bootenv}";
				run importbootenv;
			fi;
			if test "${sec_boot}" = yes; then
				if run loadcntr; then
					run mmcboot;
				else
					run netboot;
				fi;
			else
				if run loadimage; then
					run mmcboot;
				else
					run netboot;
				fi;
			fi;
		fi;
	fi;
